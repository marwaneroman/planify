# Lint → Secret Scan → SAST → Unit Tests → Dependency Audit → Build → Container Scan → Integration → E2E → Push → Deploy 
name: CI/CD

on:
  push:
    branches: [integrate, master]
  pull_request:
    branches: [integrate, master]

env:
  NODE_VERSION: "20"
  # AWS ECR settings — set AWS_ACCOUNT_ID and AWS_REGION as repo variables,
  # and AWS_ROLE_ARN as a repo secret.
  ECR_REGISTRY: ${{ vars.AWS_ACCOUNT_ID }}.dkr.ecr.${{ vars.AWS_REGION }}.amazonaws.com
  IMAGE_NAME: ${{ github.event.repository.name }}

permissions:
  contents: read
  id-token: write   # required for OIDC → AWS role assumption

jobs:

# 6. CONTAINER SCAN (Trivy) — before push
  container-scan:
    name: Container Scan (Trivy)
    runs-on: ubuntu-latest
    needs: build
    permissions:
      security-events: write
      actions: read
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # Rebuild locally for scanning (images don't persist between jobs)
      - name: Rebuild backend image for scan
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          push: false
          load: true
          tags: planify/backend:scan
          cache-from: type=gha

      - name: Rebuild frontend image for scan
        uses: docker/build-push-action@v5
        with:
          context: ./frontend
          push: false
          load: true
          tags: planify/frontend:scan
          cache-from: type=gha

      # --- Scan backend ---
      - name: Scan backend image (Trivy)
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: planify/backend:scan
          format: sarif
          output: trivy-backend.sarif
          severity: CRITICAL,HIGH
          ignore-unfixed: true
          exit-code: 0

      - name: Upload backend scan results
        uses: github/codeql-action/upload-sarif@v4
        if: always()
        with:
          sarif_file: trivy-backend.sarif
          category: trivy-backend

      # --- Scan frontend ---
      - name: Scan frontend image (Trivy)
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: planify/frontend:scan
          format: sarif
          output: trivy-frontend.sarif
          severity: CRITICAL,HIGH
          ignore-unfixed: true
          exit-code: 0

      - name: Upload frontend scan results
        uses: github/codeql-action/upload-sarif@v4
        if: always()
        with:
          sarif_file: trivy-frontend.sarif
          category: trivy-frontend
