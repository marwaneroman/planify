# Database (create user/db once with: npm run db:setup)
DATABASE_URL="postgresql://PlanifyUser:planify@localhost:5432/planify"
# Admin URL for db:setup only (default: postgresql://postgres:postgres@localhost:5432/postgres)
POSTGRES_ADMIN_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres"

# JWT secret (use a strong random value in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server
PORT=3001

# CORS (frontend origin for development)
CORS_ORIGIN="http://localhost:8080"
